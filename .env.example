# ============ FRONTEND ============
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ BACKEND ============
# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
ENV=dev
APP_NAME="Quick Certify"
APP_PORT=3001
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DATABASE_TYPE=postgres
DATABASE_HOST=host
DATABASE_PORT=5433
DATABASE_NAME=db_name
DATABASE_USERNAME=user_name
DATABASE_PASSWORD=password
DATABASE_LOG=false
DATABASE_SYNCHRONIZE=false

# SSL Configuration (for production)
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
# DATABASE_CA=
# DATABASE_KEY=
# DATABASE_CERT=

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================
# JWT Secret - Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Token expiration (in seconds)
JWT_ACCESS_TOKEN_EXPIRES_IN=900        # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES_IN=604800    # 7 days

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Reset/Verification token expiration (in seconds)
PASSWORD_RESET_EXPIRES_IN=3600         # 1 hour
EMAIL_VERIFICATION_EXPIRES_IN=86400    # 24 hours

# ===========================================
# EMAIL CONFIGURATION (Nodemailer)
# ===========================================
# SMTP Settings
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Quick Certify <noreply@example.com>"

# Preview mode (opens emails in browser instead of sending)
# Set to true for development
MAIL_PREVIEW=true

# Templates directory (relative to project root)
MAIL_TEMPLATES_DIR=./templates

# ===========================================
# SMS CONFIGURATION (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Preview mode (shows SMS in browser instead of sending)
# Set to true for development
TWILIO_PREVIEW_MODE=true

#Google authentication for social login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_cleint_secret
GOOGLE_CALLBACK_URL=callback_url
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:3002

# DigitalOcean Spaces Configuration
DO_SPACES_ACCESS_KEY=access_key
DO_SPACES_SECRET_KEY=secret_key
DO_SPACES_BUCKET=bucket_name
DO_SPACES_REGION=reagon
DO_SPACES_CDN_ENDPOINT=cdn_endpoint
