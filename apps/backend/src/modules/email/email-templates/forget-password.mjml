<mjml>
  <mj-head>
    <mj-title>Reset Your QuickCerify Password</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#000000" line-height="24px" />
      <mj-button background-color="#2563EB" color="white" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Header Section -->
    <mj-section background-color="#ffffff" padding="20px 0">
      <mj-column>
        <mj-text
          align="center"
          font-size="28px"
          font-weight="bold"
          color="#2563EB"
        >
          QuickCerify
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold">
          Password Reset Request
        </mj-text>
        <mj-text>
          We received a request to reset your QuickCerify account password.
          Click the button below to reset it:
        </mj-text>
        <mj-button href="{{resetURL}}" align="left"> Reset Password </mj-button>
        <mj-text color="#666666">
          <p>
            For security reasons, this password reset link will expire in 10
            minutes.
          </p>
          <p>
            If you didn't request this password reset, please ignore this email
            or contact support if you have concerns.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f4f4f4" padding="20px">
      <mj-column>
        <mj-text align="center" color="#666666" font-size="12px">
          This email was sent by QuickCerify. If you have any questions, please
          contact our support team.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
