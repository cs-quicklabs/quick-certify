<mjml>
  <mj-head>
    <mj-title>QuickCertify Notification</mj-title>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto"
    />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="10px">
      <mj-column width="20%" vertical-align="middle">
        <mj-image
          src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/logo.svg"
          alt="QuickCertify Logo"
          align="center"
          width="22px"
          padding="0px"
        />
      </mj-column>
      <mj-column width="80%" vertical-align="middle">
        <mj-text padding="0px"> {{{body}}} </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px">
      <mj-column width="100%">
        <mj-divider border-width="1px" border-color="#E0E0E0" />
        <mj-text align="center" font-size="12px" color="#666666">
          © {{currentYear}} QuickCertify. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
