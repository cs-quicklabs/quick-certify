<mjml>
  <mj-head>
    <mj-title>Reset Your QuickCertify Password</mj-title>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto"
    />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
      <mj-button background-color="#5e6ebf" color="white" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px 0">
      <mj-column width="100%">
        <mj-image
          src="https://via.placeholder.com/200x50"
          alt="QuickCertify Logo"
          align="center"
          width="200px"
        />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column width="100%">
        <mj-text>
          <h2 style="font-size: 20px; font-weight: bold">
            Password Reset Request
          </h2>
          <p>
            We received a request to reset your QuickCertify account password.
            Click the button below to reset it:
          </p>
        </mj-text>

        <mj-button href="{{resetURL}}" width="300px">
          Reset Password
        </mj-button>

        <mj-text color="#666666">
          <p>
            For security reasons, this password reset link will expire in 24
            hours.
          </p>
          <p>
            If you didn't request this password reset, please ignore this email
            or contact support if you have concerns.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px">
      <mj-column width="100%">
        <mj-divider border-width="1px" border-color="#E0E0E0" />
        <mj-text align="center" font-size="12px" color="#666666">
          © {{currentYear}} QuickCertify. All rights reserved.<br />
          This is an automated message, please do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
