{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": [
      "node"
    ],
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@quick-certify/shared": [
        "../../libs/src/index.ts"
      ],
    }
  },
  "include": [
    "src/**/*.ts",
    "src/common/database/config/sequelize.config.js"
  ],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
