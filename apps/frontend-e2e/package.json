{
  "name": "frontend-e2e",
  "version": "0.0.2",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "frontend"
    ],
    "targets": {
      "format": {},
      "format:check": {}
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "allure": "^3.0.1",
    "allure-playwright": "^3.4.5"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "execute:loginTests": "npx playwright test ./login.spec.ts",
    "execute:onboardingTests": "npx playwright test ./onboarding.spec.ts --workers=1",
    "execute:teamManagementTests": "npx playwright test ./teams.spec.ts",
    "generateResults": "allure serve allure-results"
  }
}
